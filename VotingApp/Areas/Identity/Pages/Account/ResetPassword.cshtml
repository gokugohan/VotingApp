@page
@model ResetPasswordModel
@{
    ViewData["Title"] = T["Reset password"];
}
<div class="card" style="max-width:26rem;margin:2rem auto">
    <form method="post" class="card-body">
        <h1 style="font-size:1.5rem">@T["Choose a new password"]</h1>
        <div asp-validation-summary="All" class="errors"></div>
        <input asp-for="Input.Code" type="hidden" />
        <div class="field">
            <label asp-for="Input.Email">@T["E-mail"]</label>
            <input asp-for="Input.Email" autocomplete="username" />
            <span asp-validation-for="Input.Email" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="Input.Password">@T["New password"]</label>
            <input asp-for="Input.Password" autocomplete="new-password" />
            <span asp-validation-for="Input.Password" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="Input.ConfirmPassword">@T["Confirm password"]</label>
            <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%">@T["Reset password"]</button>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
