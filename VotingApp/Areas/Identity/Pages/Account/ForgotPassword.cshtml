@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
}
<div class="card" style="max-width:26rem;margin:2rem auto">
    <form method="post" class="card-body">
        <h1 style="font-size:1.5rem">Forgot your password?</h1>
        <p class="muted small">Enter your e-mail. If e-mail delivery is not configured, ask an administrator to reset it.</p>
        <div asp-validation-summary="All" class="errors"></div>
        <div class="field">
            <label asp-for="Input.Email">E-mail</label>
            <input asp-for="Input.Email" autocomplete="username" />
            <span asp-validation-for="Input.Email" class="field-error"></span>
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%">Send reset link</button>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
