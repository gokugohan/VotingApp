@{
    Layout = "/Views/Shared/_Layout.cshtml";
}
<div class="page-header">
    <div class="eyebrow">@T["My account"]</div>
    <h1>@ViewData["Title"]</h1>
</div>
<div class="grid" style="grid-template-columns:minmax(0,1fr)">
    <partial name="_ManageNav" />
    <div class="form-narrow" style="max-width:40rem">
        @if (ViewData["StatusMessage"] is string status && !string.IsNullOrEmpty(status))
        {
            <div class="alert @(status.StartsWith("Error") ? "alert-bad" : "alert-ok")" role="status" style="margin-bottom:1rem">@T.Message(status)</div>
        }
        @RenderBody()
    </div>
</div>
@section Scripts {
    @RenderSection("Scripts", required: false)
}
