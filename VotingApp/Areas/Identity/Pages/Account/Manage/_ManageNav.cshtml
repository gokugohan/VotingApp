@{
    string Current(string navClass) => navClass == "active" ? "page" : null;
}
<nav class="tabs" aria-label="Account">
    <a asp-page="./Index" aria-current="@Current(ManageNavPages.IndexNavClass(ViewContext))">Profile</a>
    <a asp-page="./ChangePassword" aria-current="@Current(ManageNavPages.ChangePasswordNavClass(ViewContext))">Password</a>
    @if (User.IsInRole(VotingApp.Application.Security.Permissions.AdminRole))
    {
        <a asp-page="./Roles" aria-current="@Current(ManageNavPages.RolesNavClass(ViewContext))">Roles</a>
        <a asp-page="./Permissions" aria-current="@Current(ManageNavPages.PermissionsNavClass(ViewContext))">Permissions</a>
        <a asp-area="" asp-controller="Admin" asp-action="Users">Users and roles</a>
    }
</nav>
