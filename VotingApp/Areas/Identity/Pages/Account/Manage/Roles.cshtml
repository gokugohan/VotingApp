@page
@model RolesModel
@{
    ViewData["Title"] = T["Roles"];
    ViewData["ActivePage"] = ManageNavPages.Roles;
}
<div class="card">
    <div class="table-wrap">
        <table class="table">
            <thead><tr><th scope="col">@T["Role"]</th></tr></thead>
            <tbody>
                @foreach (var role in Model.Roles)
                {
                    <tr><td>@role.Name</td></tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer"><a asp-area="" asp-controller="Admin" asp-action="Roles">@T["Edit roles and permissions"] @Icon.Render("chevron-right")</a></div>
</div>
