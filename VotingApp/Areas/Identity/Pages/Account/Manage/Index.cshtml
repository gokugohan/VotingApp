@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
    ViewData["StatusMessage"] = Model.StatusMessage;
}
<form id="profile-form" method="post" class="card">
    <div class="card-body">
        <div asp-validation-summary="All" class="errors"></div>
        <div class="field">
            <label asp-for="Username">E-mail (user name)</label>
            <input asp-for="Username" disabled />
        </div>
        <div class="field">
            <label asp-for="Input.PhoneNumber"></label>
            <input asp-for="Input.PhoneNumber" type="tel" autocomplete="tel" />
            <span asp-validation-for="Input.PhoneNumber" class="field-error"></span>
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
