@page
@model PermissionsModel
@{
    ViewData["Title"] = "Permissions";
    ViewData["ActivePage"] = ManageNavPages.Permissions;
}
<div class="card">
    <div class="table-wrap">
        <table class="table">
            <thead><tr><th scope="col">Area</th><th scope="col">Permission</th><th scope="col">Code</th></tr></thead>
            <tbody>
                @foreach (var item in Model.PermissionItems)
                {
                    <tr><td>@item.Group</td><td>@item.Description</td><td><code class="small">@item.Name</code></td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
