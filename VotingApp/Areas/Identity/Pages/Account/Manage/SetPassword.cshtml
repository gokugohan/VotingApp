@page
@model SetPasswordModel
@{
    ViewData["Title"] = "Set password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
    ViewData["StatusMessage"] = Model.StatusMessage;
}
<form id="set-password-form" method="post" class="card">
    <div class="card-body">
        <p>This account has no password yet. Set one to sign in with your e-mail.</p>
        <div asp-validation-summary="All" class="errors"></div>
        <div class="field">
            <label asp-for="Input.NewPassword"></label>
            <input asp-for="Input.NewPassword" autocomplete="new-password" />
            <span asp-validation-for="Input.NewPassword" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="Input.ConfirmPassword"></label>
            <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
        </div>
        <button type="submit" class="btn btn-primary">Set password</button>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
