@model MunicipalityResultsPage
@{
    var s = Model.Summary;
    var m = Model.Municipality;
    ViewData["Title"] = $"{m.Name} · {s.ElectionName}";
    var names = Model.Ballot.ToDictionary(c => c.Id, c => c.Name);
    var ranked = Model.Ballot.OrderByDescending(c => m.Votes[c.Id]).ToList();
    string Short(BallotContestant c) => string.IsNullOrEmpty(c.Acronym) ? c.Name : c.Acronym;
}

<nav class="breadcrumbs" aria-label="@T["Breadcrumb"]">
    <a asp-controller="Elections" asp-action="Index">@T["Elections"]</a><span aria-hidden="true">/</span>
    <a asp-action="Round" asp-route-id="@s.RoundId">@s.ElectionName</a><span aria-hidden="true">/</span>
    <span>@m.Name</span>
</nav>

<div data-live="@Url.Action("Signature", new { id = s.RoundId })" data-live-signature="@ViewData["Signature"]" class="stack-lg">
    <div class="page-header" style="margin-bottom:0">
        <div class="eyebrow">@T["Municipality"]</div>
        <h1>@m.Name</h1>
        <div class="cluster small">
            <span class="badge badge-warn">@Icon.Render("info") @T["Provisional"]</span>
            <span class="muted">@T["Only approved polling station sheets are shown."]</span>
            <span class="muted" data-live-status aria-live="polite"></span>
        </div>
    </div>

    <section class="grid grid-4" aria-label="@T["Key figures"]">
        <div class="card stat">
            <div class="label">@T["Stations reporting"]</div>
            <div class="value">@m.ReportingPercent.ToString("0.#")%</div>
            <div class="meter" aria-hidden="true" style="margin-top:.5rem"><span style="width:@m.ReportingPercent.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></span></div>
            <div class="sub">@T["{0} of {1} stations", m.SheetsCounted, m.PollingStations]</div>
        </div>
        <div class="card stat">
            <div class="label">@T["Valid votes"]</div>
            <div class="value">@m.ValidVotes.ToString("N0")</div>
        </div>
        <div class="card stat" style="grid-column: span 2">
            <div class="label">@T["Leading"]</div>
            <div class="value" style="font-size:1.35rem">@(m.LeaderId.HasValue ? names[m.LeaderId.Value] : (m.ValidVotes > 0 ? T["Tie"] : T["No results yet"]))</div>
            @if (m.LeaderId.HasValue && m.ValidVotes > 0)
            {
                <div class="sub">@T["{0}% of valid votes", (m.Votes[m.LeaderId.Value] * 100m / m.ValidVotes).ToString("0.0")]</div>
            }
        </div>
    </section>

    <section class="card" aria-labelledby="totals-heading">
        <div class="card-header"><h2 id="totals-heading">@T["Votes in {0}", m.Name]</h2></div>
        <div class="card-body">
            <ol class="bars">
                @foreach (var c in ranked)
                {
                    var v = m.Votes[c.Id];
                    var pct = m.ValidVotes == 0 ? 0 : v * 100m / m.ValidVotes;
                    <li>
                        <div class="row1">
                            <span class="name">@c.Name</span>
                            <span class="figures"><strong>@pct.ToString("0.00")%</strong><span class="muted"> · @v.ToString("N0")</span></span>
                        </div>
                        <div class="track" aria-hidden="true"><div class="fill" style="width:@pct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div></div>
                    </li>
                }
            </ol>
        </div>
    </section>

    <section class="card" aria-labelledby="stations-heading">
        <div class="card-header">
            <h2 id="stations-heading">@T["Polling stations"]</h2>
            <span class="cluster no-print">
                <a class="btn btn-secondary btn-sm" asp-action="Official" asp-route-id="@s.RoundId" asp-route-municipality="@m.MunicipalityId">@Icon.Render("file") @T["Results record"]</a>
                <a class="btn btn-secondary btn-sm" asp-action="Csv" asp-route-id="@s.RoundId">@Icon.Render("download") @T["CSV (all municipalities)"]</a>
            </span>
        </div>
        <div class="table-wrap">
            <table class="table table-compact">
                <caption class="visually-hidden">@T["Published figures for each polling station in {0}", m.Name]</caption>
                <thead>
                    <tr>
                        <th scope="col">@T["Station"]</th>
                        <th scope="col">@T["Village"]</th>
                        @foreach (var c in Model.Ballot)
                        {
                            <th scope="col" class="num" title="@c.Name">@Short(c)</th>
                        }
                        <th scope="col" class="num">@T["Blank"]</th>
                        <th scope="col" class="num">@T["Invalid"]</th>
                        <th scope="col">@T["Signed sheet"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var st in Model.Stations)
                    {
                        <tr class="@(st.IsCounted ? "" : "is-pending")">
                            <th scope="row">@st.Station</th>
                            <td>@st.Village<div class="muted small">@st.AdministrativePost</div></td>
                            @if (st.IsCounted)
                            {
                                foreach (var c in Model.Ballot)
                                {
                                    <td class="num">@(st.Votes.TryGetValue(c.Id, out var v) ? v.ToString("N0") : "0")</td>
                                }
                                <td class="num">@st.BlankVotes.ToString("N0")</td>
                                <td class="num">@st.InvalidVotes.ToString("N0")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(st.ScanPath))
                                    {
                                        <a href="@st.ScanPath" target="_blank" rel="noopener">@T["View"] @Icon.Render("external")<span class="visually-hidden"> @T["signed sheet for {0} (opens in a new tab)", st.Station]</span></a>
                                    }
                                    else
                                    {
                                        <span class="muted">@T["Not uploaded"]</span>
                                    }
                                </td>
                            }
                            else
                            {
                                <td colspan="@(Model.Ballot.Count + 3)">
                                    <span class="badge">@(st.Status == null ? T["Not yet received"] : T["Received, being checked"])</span>
                                </td>
                            }
                        </tr>
                    }
                    @if (Model.Stations.Count == 0)
                    {
                        <tr><td colspan="@(Model.Ballot.Count + 5)" class="empty">@T["No polling stations are registered in this municipality."]</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
