@model VotingApp.Models.RoundResultsPage
@using VotingApp.Domain.Elections
@using VotingApp.Domain.Elections.Rules
@{
    var S = Model.Summary;
    var B = Model.Breakdown;
    ViewData["Title"] = $"{S.ElectionName}: results";
    var names = S.Contestants.ToDictionary(c => c.ContestantId, c => c.Name);
    string Name(Guid? id) => id.HasValue && names.TryGetValue(id.Value, out var n) ? n : "?";
    var isFinal = S.RoundStatus == ElectionStatus.Certified;
}

<div class="d-flex justify-content-between align-items-center mb-2">
    <h2 class="mb-0">@S.ElectionName @(S.RoundNumber > 1 ? $"(round {S.RoundNumber})" : "")</h2>
    <a asp-action="Summary" asp-route-id="@S.RoundId" class="btn btn-outline-secondary btn-sm">Download JSON</a>
</div>

<div class="alert @(isFinal ? "alert-success" : "alert-warning")">
    @if (isFinal)
    {
        <strong>Certified results.</strong>
    }
    else
    {
        <strong>Provisional results.</strong> <span>Only polling station sheets that have been verified and approved are counted. Official results are those certified by the competent authorities.</span>
    }
</div>

<div class="row text-center mb-3">
    <div class="col"><div class="card card-body"><h3 class="mb-0">@S.ReportingPercent%</h3><small>stations reporting (@S.SheetsCounted of @S.PollingStations)</small></div></div>
    <div class="col"><div class="card card-body"><h3 class="mb-0">@S.ValidVotes.ToString("N0")</h3><small>valid votes</small></div></div>
    <div class="col"><div class="card card-body"><h3 class="mb-0">@S.BlankVotes.ToString("N0")</h3><small>blank</small></div></div>
    <div class="col"><div class="card card-body"><h3 class="mb-0">@S.InvalidVotes.ToString("N0")</h3><small>invalid</small></div></div>
</div>

@if (S.Presidential != null && S.SheetsCounted > 0)
{
    var p = S.Presidential;
    <div class="alert alert-info">
        @switch (p.Outcome)
        {
            case PresidentialOutcome.Elected:
                <span><strong>@Name(p.WinnerId)</strong> has more than half of the valid votes counted so far.</span>
                break;
            case PresidentialOutcome.Runoff:
                <span>No candidate has more than half of the valid votes (@p.MajorityThreshold.ToString("N0") needed). Heading to a runoff between <strong>@Name(p.RunoffContestantIds[0])</strong> and <strong>@Name(p.RunoffContestantIds[1])</strong>.</span>
                break;
            case PresidentialOutcome.TieRequiresResolution:
                <span>A tie between @string.Join(", ", p.TiedContestantIds.Select(id => Name(id))) decides the outcome and must be resolved under the law.</span>
                break;
        }
    </div>
}
@if (S.Parliamentary != null && S.SheetsCounted > 0)
{
    var pr = S.Parliamentary;
    <div class="alert alert-info">
        Projected allocation of @pr.TotalSeats seats (D'Hondt, @pr.ThresholdPercent% threshold) from the votes counted so far.
        @if (pr.LastSeatWinnerId.HasValue)
        {
            <span>Last seat: <strong>@Name(pr.LastSeatWinnerId)</strong>@(pr.LastSeatDecidedByTie ? " (decided by a tie-break)" : ""); next in line: <strong>@Name(pr.NextInLineId)</strong>.</span>
        }
    </div>
}

<div class="card">
    <div class="card-body table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>@(S.Type == ElectionType.Presidential ? "Candidate" : "Party / coalition")</th>
                    <th class="text-right">Votes</th>
                    <th class="text-right">% of valid</th>
                    @if (S.Parliamentary != null) { <th class="text-right">Seats</th> }
                    <th style="width: 35%"></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var c in S.Contestants)
            {
                <tr>
                    <td>@c.Name @if (!string.IsNullOrEmpty(c.Acronym)) { <span class="text-muted">(@c.Acronym)</span> }</td>
                    <td class="text-right">@c.Votes.ToString("N0")</td>
                    <td class="text-right">@c.PercentOfValid.ToString("0.00")%</td>
                    @if (S.Parliamentary != null) { <td class="text-right"><strong>@c.Seats</strong></td> }
                    <td>
                        <div class="progress" style="height: 0.75rem" role="img" aria-label="@c.PercentOfValid.ToString("0.0")% of valid votes">
                            <div class="progress-bar" style="width: @c.PercentOfValid.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        <p class="text-muted small mb-0">Updated @S.GeneratedAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC. This page refreshes every 30 seconds.</p>
    </div>
</div>

@if (B != null && B.Municipalities.Count > 0)
{
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="card-title mb-0">By municipality</h4>
            <span>
                <a asp-action="Csv" asp-route-id="@S.RoundId" class="btn btn-outline-secondary btn-sm">Download station results (CSV)</a>
                <a asp-action="Municipalities" asp-route-id="@S.RoundId" class="btn btn-outline-secondary btn-sm">JSON</a>
            </span>
        </div>
        <div class="card-body table-responsive">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Municipality</th>
                        <th class="text-right">Reporting</th>
                        <th>Leading</th>
                        @foreach (var c in B.Ballot)
                        {
                            <th class="text-right">@(string.IsNullOrEmpty(c.Acronym) ? c.Name : c.Acronym)</th>
                        }
                    </tr>
                </thead>
                <tbody>
                @foreach (var m in B.Municipalities)
                {
                    <tr>
                        <td><a asp-action="Municipality" asp-route-roundId="@S.RoundId" asp-route-id="@m.MunicipalityId">@m.Name</a></td>
                        <td class="text-right">@m.ReportingPercent% <small class="text-muted">(@m.SheetsCounted/@m.PollingStations)</small></td>
                        <td>@(m.LeaderId.HasValue ? Name(m.LeaderId) : "-")</td>
                        @foreach (var c in B.Ballot)
                        {
                            <td class="text-right">@m.Votes[c.Id].ToString("N0")</td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
    <script>setTimeout(function () { window.location.reload(); }, 30000);</script>
}
