@model List<VotingApp.Controllers.UserRolesRow>
@{
    ViewData["Title"] = "Users";
    var allRoles = (List<string>)ViewData["AllRoles"];
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Users and roles</h2>
    <span>
        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-success btn-sm"><i class="fa fa-plus"></i> Create user</a>
        <a asp-action="Roles" class="btn btn-outline-secondary btn-sm">Roles and permissions</a>
        <a asp-controller="Elections" asp-action="Scopes" class="btn btn-outline-secondary btn-sm">User municipalities</a>
    </span>
</div>
<div class="card">
    <div class="card-body table-responsive">
        <table class="table">
            <thead><tr><th>User</th><th>Last sign-in</th><th>Roles</th><th></th></tr></thead>
            <tbody>
            @foreach (var row in Model)
            {
                var formId = "roles-" + row.User.Id;
                <tr>
                    <td>@row.User.Email<br /><small class="text-muted">@row.User.FirstName @row.User.LastName</small></td>
                    <td><small>@(row.User.LastLoginDateUtc?.ToString("yyyy-MM-dd HH:mm") ?? "never")</small></td>
                    <td>
                        <form id="@formId" asp-action="SetUserRoles" method="post">
                            <input type="hidden" name="userId" value="@row.User.Id" />
                            @foreach (var role in allRoles)
                            {
                                <label class="mr-3 mb-1 font-weight-normal">
                                    <input type="checkbox" name="roleNames" value="@role" checked="@row.Roles.Contains(role)" /> @role
                                </label>
                            }
                        </form>
                    </td>
                    <td><button type="submit" form="@formId" class="btn btn-primary btn-sm">Save</button></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
