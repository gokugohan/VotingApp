@model List<VotingApp.Controllers.RolePermissionsRow>
@using VotingApp.Application.Security
@{
    ViewData["Title"] = "Roles";
    var groups = Permissions.All.GroupBy(p => p.Group).ToList();
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Roles and permissions</h2>
    <a asp-action="Users">Back to users</a>
</div>
<p class="text-muted">
    Suggested set-up for results night: <strong>Clerk</strong> (enter results), <strong>Verifier</strong> (verify results),
    <strong>Municipal supervisor</strong> (verify + approve), <strong>National tabulation</strong> (approve + lock).
    Then limit clerks and supervisors to their municipalities under User municipalities.
</p>

<form asp-action="CreateRole" method="post" class="form-inline mb-3">
    <input name="name" class="form-control form-control-sm mr-2" placeholder="New role name" required maxlength="100" />
    <button type="submit" class="btn btn-success btn-sm">Create role</button>
</form>

@foreach (var row in Model)
{
    var isAdmin = row.Role.Name == Permissions.AdminRole;
    <div class="card">
        <div class="card-header"><h4 class="card-title mb-0">@row.Role.Name</h4></div>
        <div class="card-body">
            <form asp-action="SetRolePermissions" method="post">
                <input type="hidden" name="roleId" value="@row.Role.Id" />
                <div class="row">
                    @foreach (var group in groups)
                    {
                        <div class="col-md-3 mb-2">
                            <strong>@group.Key</strong>
                            @foreach (var p in group)
                            {
                                <div>
                                    <label class="font-weight-normal mb-0">
                                        <input type="checkbox" name="permissions" value="@p.Name" checked="@(isAdmin || row.Permissions.Contains(p.Name))" disabled="@isAdmin" /> @p.Description
                                    </label>
                                </div>
                            }
                        </div>
                    }
                </div>
                @if (!isAdmin)
                {
                    <button type="submit" class="btn btn-primary btn-sm">Save permissions</button>
                }
                else
                {
                    <small class="text-muted">The Admin role always has every permission.</small>
                }
            </form>
        </div>
    </div>
}
