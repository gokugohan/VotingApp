@model IEnumerable<VotingApp.Domain.Entities.Candidate>
@using VotingApp.Application.Security
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService Authz
@{
    ViewData["Title"] = T["Candidates"];
    var canManage = User.Identity?.IsAuthenticated == true && (await Authz.AuthorizeAsync(User, Permissions.ManageCandidates)).Succeeded;
}
<div class="page-header spread">
    <div>
        <h1>@T["Candidates"]</h1>
        <p>@T["Profiles with photo and biography. Link a profile to a contestant when setting up an election."]</p>
    </div>
    @if (canManage)
    {
        <a asp-action="Create" class="btn btn-primary">@Icon.Render("plus") @T["New candidate"]</a>
    }
</div>

@if (!Model.Any())
{
    <div class="card"><div class="empty"><h3>@T["No candidates yet"]</h3></div></div>
}
else
{
    <div class="grid grid-3">
        @foreach (var c in Model)
        {
            <article class="card">
                <div class="card-body cluster" style="flex-wrap:nowrap;align-items:flex-start;gap:1rem">
                    <partial name="_Avatar" model="(c.Name, c.Avatar, (string)null)" />
                    <div style="min-width:0">
                        <h2 style="font-size:1.05rem;margin:0"><a asp-action="Details" asp-route-id="@c.Id">@c.Name</a></h2>
                        @if (!string.IsNullOrEmpty(c.Description))
                        {
                            <p class="muted small" style="margin:.25rem 0 0">@c.Description</p>
                        }
                    </div>
                </div>
                @if (canManage)
                {
                    <div class="card-footer cluster">
                        <a class="btn btn-ghost btn-sm" asp-action="Edit" asp-route-id="@c.Id">@Icon.Render("pencil") @T["Edit"]</a>
                        <a class="btn btn-ghost btn-sm" asp-action="Delete" asp-route-id="@c.Id">@Icon.Render("trash") @T["Delete"]</a>
                    </div>
                }
            </article>
        }
    </div>
}
