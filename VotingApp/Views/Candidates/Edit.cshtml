@model EditCandidateModel
@{
    ViewData["Title"] = T["Edit {0}", Model.Name];
}
<nav class="breadcrumbs" aria-label="@T["Breadcrumb"]"><a asp-action="Index">@T["Candidates"]</a><span aria-hidden="true">/</span><span>@Model.Name</span></nav>
<div class="page-header"><h1>@T["Edit candidate"]</h1></div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="card form-narrow">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="errors"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Avatar" />
        <partial name="_CandidateFields" model="(Model.Name, Model.Description, Model.ShortBiography, Model.Avatar)" />
        <div class="actions">
            <button type="submit" class="btn btn-primary">@T["Save changes"]</button>
            <a asp-action="Index" class="btn btn-ghost">@T["Cancel"]</a>
        </div>
    </div>
</form>
