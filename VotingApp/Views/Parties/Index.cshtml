@model List<PartySummary>
@using VotingApp.Application.Security
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService Authz
@{
    ViewData["Title"] = T["Parties and coalitions"];
    var canManage = User.Identity?.IsAuthenticated == true && (await Authz.AuthorizeAsync(User, Permissions.ManageElections)).Succeeded;
}
<div class="page-header spread">
    <div>
        <h1>@T["Parties and coalitions"]</h1>
        <p>@T["Each party has one record across elections, so its results can be followed over time."]</p>
    </div>
    @if (canManage)
    {
        <a asp-action="Create" class="btn btn-primary">@Icon.Render("plus") @T["New party"]</a>
    }
</div>
<div class="card">
    <div class="table-wrap">
        <table class="table">
            <thead><tr><th scope="col">@T["Name"]</th><th scope="col">@T["Acronym"]</th><th scope="col">@T["Type"]</th><th scope="col" class="num">@T["Elections"]</th></tr></thead>
            <tbody>
                @foreach (var row in Model)
                {
                    <tr>
                        <th scope="row"><a asp-action="Details" asp-route-id="@row.Party.Id">@row.Party.Name</a></th>
                        <td>@row.Party.Acronym</td>
                        <td>@T[row.Party.Kind.ToString()]</td>
                        <td class="num">@row.Elections</td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="4" class="empty">@T["No parties yet. They are added when you put a party on a parliamentary ballot."]</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
