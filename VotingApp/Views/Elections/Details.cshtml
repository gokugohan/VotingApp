@model VotingApp.Domain.Elections.Election
@using VotingApp.Domain.Elections
@{
    ViewData["Title"] = Model.Name;
    var current = Model.Rounds.OrderByDescending(r => r.Number).First();
    ElectionStatus? next = current.Status == ElectionStatus.Certified ? null : current.Status + 1;
    var canEditBallot = Model.Status == ElectionStatus.Setup && Model.Rounds.Count == 1;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">@Model.Name</h2>
    <a asp-action="Index">Back to elections</a>
</div>

<div class="row">
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header"><h4 class="card-title mb-0">Election</h4></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5">Type</dt><dd class="col-7">@Model.Type</dd>
                    <dt class="col-5">Date</dt><dd class="col-7">@Model.ElectionDate.ToString("yyyy-MM-dd")</dd>
                    @if (Model.Type == ElectionType.Parliamentary)
                    {
                        <dt class="col-5">Seats</dt><dd class="col-7">@Model.TotalSeats</dd>
                        <dt class="col-5">Threshold</dt><dd class="col-7">@Model.ThresholdPercent %</dd>
                    }
                    <dt class="col-5">Current round</dt><dd class="col-7">@current.Number: <span class="badge badge-info">@current.Status</span></dd>
                </dl>
                @if (next.HasValue)
                {
                    <form asp-action="SetStatus" method="post" class="mt-3" data-confirm="Move round @current.Number to @next? Status cannot go back.">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="status" value="@next" />
                        <button type="submit" class="btn btn-primary btn-sm">Move to @next</button>
                        <small class="d-block text-muted mt-1">Result entry is open while the round is Counting or Provisional.</small>
                    </form>
                }
                @if (Model.Type == ElectionType.Presidential && Model.Rounds.Count == 1)
                {
                    <form asp-action="CreateRunoff" method="post" class="mt-3">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <label for="votingDate">Runoff date</label>
                        <input type="date" id="votingDate" name="votingDate" class="form-control form-control-sm mb-2" required />
                        <button type="submit" class="btn btn-outline-primary btn-sm">Create runoff from approved results</button>
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        @foreach (var round in Model.Rounds.OrderBy(r => r.Number))
        {
            <div class="card">
                <div class="card-header d-flex justify-content-between">
                    <h4 class="card-title mb-0">Round @round.Number ballot</h4>
                    <span>
                        <a asp-controller="ResultSheets" asp-action="Index" asp-route-roundId="@round.Id">Result sheets</a> |
                        <a asp-controller="Results" asp-action="Round" asp-route-id="@round.Id">Public results</a>
                    </span>
                </div>
                <div class="card-body">
                    <table class="table table-sm">
                        <thead><tr><th>#</th><th>Name</th><th>Type</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var rc in round.Contestants.OrderBy(c => c.BallotPosition))
                        {
                            <tr>
                                <td>@rc.BallotPosition</td>
                                <td>
                                    @rc.Contestant.Name
                                    @if (!string.IsNullOrEmpty(rc.Contestant.Acronym))
                                    {
                                        <span class="text-muted">(@rc.Contestant.Acronym)</span>
                                    }
                                </td>
                                <td>@rc.Contestant.Type</td>
                                <td>
                                    @if (canEditBallot)
                                    {
                                        <form asp-action="RemoveContestant" method="post" class="d-inline">
                                            <input type="hidden" name="electionId" value="@Model.Id" />
                                            <input type="hidden" name="contestantId" value="@rc.ContestantId" />
                                            <button type="submit" class="btn btn-link btn-sm text-danger p-0">Remove</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (canEditBallot)
        {
            <div class="card">
                <div class="card-header"><h4 class="card-title mb-0">Add @(Model.Type == ElectionType.Presidential ? "candidate" : "party or coalition")</h4></div>
                <div class="card-body">
                    <form asp-action="AddContestant" method="post">
                        <input type="hidden" name="ElectionId" value="@Model.Id" />
                        <div class="form-row">
                            <div class="form-group col-md-5"><input name="Name" class="form-control" placeholder="Name" required maxlength="200" /></div>
                            <div class="form-group col-md-2"><input name="Acronym" class="form-control" placeholder="Acronym" maxlength="30" /></div>
                            <div class="form-group col-md-3">
                                @if (Model.Type == ElectionType.Presidential)
                                {
                                    <input type="hidden" name="Type" value="@ContestantType.Candidate" />
                                    <span class="form-control-plaintext">Candidate</span>
                                }
                                else
                                {
                                    <select name="Type" class="form-control">
                                        <option value="@ContestantType.Party">Party</option>
                                        <option value="@ContestantType.Coalition">Coalition</option>
                                    </select>
                                }
                            </div>
                            <div class="form-group col-md-2"><button type="submit" class="btn btn-success btn-block">Add</button></div>
                        </div>
                        <div class="form-group mb-0">
                            <label for="CandidateId">Link to candidate profile (optional, for photo and biography)</label>
                            <select id="CandidateId" name="CandidateId" class="form-control" asp-items="ViewBag.Candidates">
                                <option value="">(none)</option>
                            </select>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll("form[data-confirm]").forEach(function (form) {
            form.addEventListener("submit", function (e) {
                if (!window.confirm(form.getAttribute("data-confirm"))) e.preventDefault();
            });
        });
    </script>
}
