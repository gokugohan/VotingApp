@model Election
@{
    ViewData["Title"] = Model.Name;
    var current = Model.Rounds.OrderByDescending(r => r.Number).First();
    ElectionStatus? next = current.Status == ElectionStatus.Certified ? null : current.Status + 1;
    var canEditBallot = Model.Status == ElectionStatus.Setup && Model.Rounds.Count == 1;
    var steps = Enum.GetValues<ElectionStatus>();
    string NextHelp(ElectionStatus s) => s switch
    {
        ElectionStatus.Voting => "Polls are open. The ballot can no longer change.",
        ElectionStatus.Counting => "Result sheet entry opens for clerks.",
        ElectionStatus.Provisional => "Provisional results are announced; entry stays open for remaining stations.",
        ElectionStatus.Certified => "Final: results are certified and the round can no longer change.",
        _ => "",
    };
}

<nav class="breadcrumbs" aria-label="Breadcrumb"><a asp-action="Index">Elections</a><span aria-hidden="true">/</span><span>@Model.Name</span></nav>
<div class="page-header">
    <div class="eyebrow">@(Model.Type == ElectionType.Presidential ? "Presidential" : "Parliamentary") election · @Model.ElectionDate.ToString("d MMMM yyyy")</div>
    <h1>@Model.Name</h1>
</div>

<div class="grid grid-side">
    <div class="stack-lg">
        @foreach (var round in Model.Rounds.OrderBy(r => r.Number))
        {
            <section class="card" aria-labelledby="round-@round.Number">
                <div class="card-header">
                    <h2 id="round-@round.Number">@(round.Number == 1 ? (Model.Rounds.Count > 1 ? "First round" : "Ballot") : "Runoff") <span class="muted small">@round.VotingDate.ToString("d MMM yyyy")</span></h2>
                    <span class="cluster">
                        <a class="btn btn-ghost btn-sm" asp-controller="ResultSheets" asp-action="Index" asp-route-roundId="@round.Id">@Icon.Render("file") Result sheets</a>
                        <a class="btn btn-ghost btn-sm" asp-controller="Results" asp-action="Round" asp-route-id="@round.Id">@Icon.Render("chart") Results</a>
                    </span>
                </div>
                <div class="table-wrap">
                    <table class="table">
                        <thead><tr><th scope="col" class="num" style="width:3rem">#</th><th scope="col">Name</th><th scope="col">Type</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
                        <tbody>
                            @foreach (var rc in round.Contestants.OrderBy(c => c.BallotPosition))
                            {
                                <tr>
                                    <td class="num">@rc.BallotPosition</td>
                                    <th scope="row">@rc.Contestant.Name @if (!string.IsNullOrEmpty(rc.Contestant.Acronym)) { <span class="muted">(@rc.Contestant.Acronym)</span> }</th>
                                    <td>@rc.Contestant.Type</td>
                                    <td class="actions-cell">
                                        @if (canEditBallot)
                                        {
                                            <form asp-action="RemoveContestant" method="post" class="inline" data-confirm="Remove @rc.Contestant.Name from the ballot?">
                                                <input type="hidden" name="electionId" value="@Model.Id" />
                                                <input type="hidden" name="contestantId" value="@rc.ContestantId" />
                                                <button type="submit" class="btn btn-ghost btn-sm" aria-label="Remove @rc.Contestant.Name">@Icon.Render("trash") Remove</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (!round.Contestants.Any())
                            {
                                <tr><td colspan="4" class="empty">No contestants yet. Add them below.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }

        @if (canEditBallot)
        {
            <section class="card" aria-labelledby="add-heading">
                <div class="card-header"><h2 id="add-heading">Add @(Model.Type == ElectionType.Presidential ? "a candidate" : "a party or coalition")</h2></div>
                <form asp-action="AddContestant" method="post" class="card-body">
                    <input type="hidden" name="ElectionId" value="@Model.Id" />
                    <div class="form-grid">
                        <div class="field">
                            <label for="c-name">Name</label>
                            <input id="c-name" name="Name" required maxlength="200" />
                        </div>
                        <div class="field">
                            <label for="c-acronym">Acronym <span class="muted">(optional)</span></label>
                            <input id="c-acronym" name="Acronym" maxlength="30" />
                        </div>
                        @if (Model.Type == ElectionType.Presidential)
                        {
                            <input type="hidden" name="Type" value="@ContestantType.Candidate" />
                        }
                        else
                        {
                            <div class="field">
                                <label for="c-type">Type</label>
                                <select id="c-type" name="Type">
                                    <option value="@ContestantType.Party">Party</option>
                                    <option value="@ContestantType.Coalition">Coalition</option>
                                </select>
                            </div>
                        }
                        <div class="field">
                            <label for="c-profile">Candidate profile <span class="muted">(optional)</span></label>
                            <select id="c-profile" name="CandidateId" asp-items="ViewBag.Candidates"><option value="">None</option></select>
                            <span class="hint">Links a photo and biography.</span>
                        </div>
                    </div>
                    <div class="actions"><button type="submit" class="btn btn-primary">@Icon.Render("plus") Add to ballot</button></div>
                </form>
            </section>
        }
    </div>

    <aside class="stack-lg">
        <section class="card" aria-labelledby="status-heading">
            <div class="card-header"><h2 id="status-heading">Status</h2></div>
            <div class="card-body stack">
                <ol style="list-style:none;margin:0;padding:0" class="stack">
                    @foreach (var st in steps)
                    {
                        var done = st < current.Status; var now = st == current.Status;
                        <li class="cluster" style="flex-wrap:nowrap">
                            <span class="badge @(now ? "badge-info" : done ? "badge-ok" : "")" style="min-width:1.6rem;justify-content:center">@(done ? Icon.Render("check") : new Microsoft.AspNetCore.Html.HtmlString(((int)st + 1).ToString()))</span>
                            <span style="@(now ? "font-weight:700" : done ? "" : "color:var(--muted)")">@st @if (now) { <span class="visually-hidden">(current)</span> }</span>
                        </li>
                    }
                </ol>
                @if (next.HasValue)
                {
                    <form asp-action="SetStatus" method="post" data-confirm="Move to @next? This cannot be undone.">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="status" value="@next" />
                        <button type="submit" class="btn btn-primary" style="width:100%">Move to @next</button>
                        <p class="hint" style="margin:.5rem 0 0">@NextHelp(next.Value)</p>
                    </form>
                }
            </div>
        </section>

        <section class="card" aria-labelledby="rules-heading">
            <div class="card-header"><h2 id="rules-heading">Rules</h2></div>
            <div class="card-body">
                <dl class="dl">
                    @if (Model.Type == ElectionType.Presidential)
                    {
                        <dt>Winner</dt><dd>More than 50% of valid votes; otherwise a runoff between the top two.</dd>
                    }
                    else
                    {
                        <dt>Seats</dt><dd>@Model.TotalSeats</dd>
                        <dt>Threshold</dt><dd>@Model.ThresholdPercent?.ToString("0.##")% of valid votes</dd>
                        <dt>Method</dt><dd>D'Hondt</dd>
                    }
                </dl>
            </div>
        </section>

        @if (Model.Type == ElectionType.Presidential && Model.Rounds.Count == 1)
        {
            <section class="card" aria-labelledby="runoff-heading">
                <div class="card-header"><h2 id="runoff-heading">Runoff</h2></div>
                <form asp-action="CreateRunoff" method="post" class="card-body">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <p class="hint">Uses approved first-round results. Only possible when no candidate has a majority and no tie decides who qualifies.</p>
                    <div class="field">
                        <label for="votingDate">Runoff voting date</label>
                        <input type="date" id="votingDate" name="votingDate" required />
                    </div>
                    <button type="submit" class="btn btn-secondary">Create runoff round</button>
                </form>
            </section>
        }
    </aside>
</div>
