@model IEnumerable<VotingApp.Models.UserScopeRow>
@{
    ViewData["Title"] = "User municipalities";
    var municipalities = (List<VotingApp.Domain.Entities.Area>)ViewData["Municipalities"];
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">User municipalities</h2>
    <a asp-action="Index">Back to elections</a>
</div>
<p class="text-muted">
    Users with municipalities assigned can only enter, verify and approve result sheets there.
    Users without assignments have no municipal access; admins are always national.
    What a user may do (enter, verify, approve, lock) comes from their role's permissions.
</p>
<div class="card">
    <div class="card-body table-responsive">
        <table class="table">
            <thead><tr><th>User</th><th>Municipalities</th><th></th></tr></thead>
            <tbody>
            @foreach (var row in Model)
            {
                var formId = "scope-" + row.User.Id;
                <tr>
                    <td>@row.User.Email<br /><small class="text-muted">@row.User.FirstName @row.User.LastName</small></td>
                    <td>
                        <form id="@formId" asp-action="Scopes" method="post">
                            <input type="hidden" name="userId" value="@row.User.Id" />
                            @foreach (var m in municipalities)
                            {
                                <label class="mr-3 mb-1 font-weight-normal">
                                    <input type="checkbox" name="municipalityIds" value="@m.Id" checked="@row.MunicipalityIds.Contains(m.Id)" /> @m.Name
                                </label>
                            }
                        </form>
                    </td>
                    <td><button type="submit" form="@formId" class="btn btn-primary btn-sm">Save</button></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
