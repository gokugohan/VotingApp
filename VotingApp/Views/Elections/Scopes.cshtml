@model IEnumerable<UserScopeRow>
@{
    ViewData["Title"] = T["User municipalities"];
    var municipalities = (List<VotingApp.Domain.Entities.Area>)ViewData["Municipalities"];
}
<div class="page-header">
    <h1>@T["User municipalities"]</h1>
    <p>@T["Staff assigned to municipalities can only enter, verify and approve result sheets there. Staff without assignments have no access to result sheets; admins always see every municipality."] @T.Html("What each person may do comes from their role (<a href=\"{0}\">roles and permissions</a>).", Url.Action("Roles", "Admin"))</p>
</div>

<div class="stack">
    @foreach (var row in Model)
    {
        var formId = "scope-" + row.User.Id;
        <form id="@formId" asp-action="Scopes" method="post" class="card">
            <input type="hidden" name="userId" value="@row.User.Id" />
            <div class="card-header">
                <h2 style="font-size:1rem">@row.User.Email <span class="muted small" style="font-weight:400">@row.User.FirstName @row.User.LastName</span></h2>
                <span class="badge">@T["{0} of {1}", row.MunicipalityIds.Count, municipalities.Count]</span>
            </div>
            <div class="card-body">
                <fieldset style="border:0;margin:0;padding:0">
                    <legend class="visually-hidden">@T["Municipalities for {0}", row.User.Email]</legend>
                    <div class="cluster" style="gap:.25rem 1.25rem">
                        @foreach (var m in municipalities)
                        {
                            <label class="check"><input type="checkbox" name="municipalityIds" value="@m.Id" checked="@row.MunicipalityIds.Contains(m.Id)" /> @m.Name</label>
                        }
                    </div>
                </fieldset>
            </div>
            <div class="card-footer"><button type="submit" class="btn btn-primary btn-sm">@T["Save"]</button></div>
        </form>
    }
</div>
