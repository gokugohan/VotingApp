@model IEnumerable<VotingApp.Domain.Elections.Election>
@using VotingApp.Application.Security
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService Authz
@{
    ViewData["Title"] = "Elections";
    var canManage = (await Authz.AuthorizeAsync(User, Permissions.ManageElections)).Succeeded;
    var canWorkResults = User.Identity?.IsAuthenticated == true && (await Authz.AuthorizeAsync(User,
        Permissions.EnterResults + "|" + Permissions.VerifyResults + "|" + Permissions.ApproveResults + "|" + Permissions.LockResults)).Succeeded;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Elections</h2>
    <div>
        @if (User.IsInRole(Permissions.AdminRole))
        {
            <a asp-controller="Admin" asp-action="Users" class="btn btn-outline-secondary btn-sm">Users and roles</a>
            <a asp-action="Scopes" class="btn btn-outline-secondary btn-sm">User municipalities</a>
        }
        @if (canManage)
        {
            <a asp-action="Create" class="btn btn-success btn-sm"><i class="fa fa-plus"></i> New election</a>
        }
    </div>
</div>

<div class="card">
    <div class="card-body table-responsive">
        <table class="table">
            <thead><tr><th>Name</th><th>Type</th><th>Date</th><th>Status</th><th>Rounds</th><th></th></tr></thead>
            <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td>@e.Name</td>
                    <td>@e.Type</td>
                    <td>@e.ElectionDate.ToString("yyyy-MM-dd")</td>
                    <td><span class="badge badge-info">@e.Status</span></td>
                    <td>
                        @foreach (var r in e.Rounds.OrderBy(r => r.Number))
                        {
                            <div>
                                Round @r.Number (@r.VotingDate.ToString("yyyy-MM-dd")):
                                <a asp-controller="Results" asp-action="Round" asp-route-id="@r.Id">results</a>
                                @if (canWorkResults)
                                {
                                    <text> | </text><a asp-controller="ResultSheets" asp-action="Index" asp-route-roundId="@r.Id">result sheets</a>
                                }
                            </div>
                        }
                    </td>
                    <td>
                        @if (canManage)
                        {
                            <a asp-action="Details" asp-route-id="@e.Id">Manage</a>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="text-muted">No elections yet.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
