@model IEnumerable<Election>
@using VotingApp.Application.Security
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService Authz
@{
    ViewData["Title"] = T["Elections"];
    var canManage = (await Authz.AuthorizeAsync(User, Permissions.ManageElections)).Succeeded;
    var canWorkResults = User.Identity?.IsAuthenticated == true && (await Authz.AuthorizeAsync(User,
        Permissions.EnterResults + "|" + Permissions.VerifyResults + "|" + Permissions.ApproveResults + "|" + Permissions.LockResults)).Succeeded;
    string StatusBadge(ElectionStatus s) => s switch
    {
        ElectionStatus.Certified => "badge-ok",
        ElectionStatus.Counting or ElectionStatus.Provisional => "badge-warn",
        ElectionStatus.Voting => "badge-info",
        _ => "",
    };
}

<div class="page-header spread">
    <div>
        <h1>@T["Elections"]</h1>
        <p>@T["Results, open data and, for staff, result sheet entry for each election round."] <a asp-controller="Parties" asp-action="Index">@T["Follow a party across elections."]</a></p>
    </div>
    @if (canManage)
    {
        <a asp-action="Create" class="btn btn-primary">@Icon.Render("plus") @T["New election"]</a>
    }
</div>

@if (!Model.Any())
{
    <div class="card"><div class="empty"><h3>@T["No elections yet"]</h3>@if (canManage) { <p><a asp-action="Create">@T["Create the first election"]</a></p> }</div></div>
}
else
{
    <div class="grid grid-2">
        @foreach (var e in Model)
        {
            <article class="card">
                <div class="card-body stack">
                    <div class="spread">
                        <span class="eyebrow muted small" style="text-transform:uppercase;letter-spacing:.06em;font-weight:600">@(e.Type == ElectionType.Presidential ? T["Presidential"] : T["Parliamentary"]) · @e.ElectionDate.ToString("d MMMM yyyy")</span>
                        <span class="badge @StatusBadge(e.Status)">@T[e.Status.ToString()]</span>
                    </div>
                    <h2 style="margin:0">@e.Name</h2>
                    <ul style="list-style:none;margin:0;padding:0" class="stack">
                        @foreach (var r in e.Rounds.OrderBy(r => r.Number))
                        {
                            <li class="spread" style="border-top:1px solid var(--border);padding-top:.75rem">
                                <span>
                                    <strong>@(e.Rounds.Count > 1 ? (r.Number == 1 ? T["First round"] : T["Runoff"]) : T["Results"])</strong>
                                    <span class="muted small"> · @r.VotingDate.ToString("d MMM yyyy") · @T[r.Status.ToString()]</span>
                                </span>
                                <span class="cluster">
                                    @if (r.Status >= ElectionStatus.Counting)
                                    {
                                        <a class="btn btn-secondary btn-sm" asp-controller="Results" asp-action="Round" asp-route-id="@r.Id">@Icon.Render("chart") @T["Results"]</a>
                                    }
                                    @if (canWorkResults)
                                    {
                                        <a class="btn btn-ghost btn-sm" asp-controller="ResultSheets" asp-action="Index" asp-route-roundId="@r.Id">@Icon.Render("file") @T["Result sheets"]</a>
                                    }
                                </span>
                            </li>
                        }
                    </ul>
                </div>
                @if (canManage)
                {
                    <div class="card-footer"><a asp-action="Details" asp-route-id="@e.Id">@T["Manage election"] @Icon.Render("chevron-right")</a></div>
                }
            </article>
        }
    </div>
}
