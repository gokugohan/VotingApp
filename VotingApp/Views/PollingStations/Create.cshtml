@model VotingApp.Domain.Entities.PollingStation
@{
    ViewData["Title"] = T["New polling station name"];
}
<nav class="breadcrumbs" aria-label="@T["Breadcrumb"]"><a asp-action="Index">@T["Polling station names"]</a><span aria-hidden="true">/</span><span>@T["New"]</span></nav>
<div class="page-header"><h1>@T["New polling station name"]</h1></div>
<form asp-action="Create" method="post" class="card form-narrow">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="errors"></div>
        <div class="field">
            <label asp-for="Name"></label>
            <input asp-for="Name" required maxlength="200" />
            <span asp-validation-for="Name" class="field-error"></span>
        </div>
        <div class="actions">
            <button type="submit" class="btn btn-primary">@T["Create"]</button>
            <a asp-action="Index" class="btn btn-ghost">@T["Cancel"]</a>
        </div>
    </div>
</form>
