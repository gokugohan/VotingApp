@model VotingApp.Domain.Entities.PollingStation
@{
    ViewData["Title"] = "Rename " + Model.Name;
}
<nav class="breadcrumbs" aria-label="Breadcrumb"><a asp-action="Index">Polling station names</a><span aria-hidden="true">/</span><span>@Model.Name</span></nav>
<div class="page-header"><h1>Rename polling station</h1></div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card form-narrow">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="errors"></div>
        <input type="hidden" asp-for="Id" />
        <div class="field">
            <label asp-for="Name"></label>
            <input asp-for="Name" required maxlength="200" />
            <span asp-validation-for="Name" class="field-error"></span>
        </div>
        <div class="actions">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-ghost">Cancel</a>
        </div>
    </div>
</form>
