@model VotingApp.Domain.Entities.PollingStation
@{
    ViewData["Title"] = "Delete " + Model.Name;
}
<nav class="breadcrumbs" aria-label="Breadcrumb"><a asp-action="Index">Polling station names</a><span aria-hidden="true">/</span><span>@Model.Name</span></nav>
<div class="page-header"><h1>Delete polling station name</h1></div>
<div class="card form-narrow">
    <div class="card-body stack">
        <p>Delete <strong>@Model.Name</strong>? A name that is placed in a village must be removed there first.</p>
        <form asp-action="Delete" method="post" class="actions">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">@Icon.Render("trash") Delete</button>
            <a asp-action="Index" class="btn btn-ghost">Cancel</a>
        </form>
    </div>
</div>
