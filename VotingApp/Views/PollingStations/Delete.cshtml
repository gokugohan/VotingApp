@model VotingApp.Domain.Entities.PollingStation
@{
    ViewData["Title"] = T["Delete {0}", Model.Name];
}
<nav class="breadcrumbs" aria-label="@T["Breadcrumb"]"><a asp-action="Index">@T["Polling station names"]</a><span aria-hidden="true">/</span><span>@Model.Name</span></nav>
<div class="page-header"><h1>@T["Delete polling station name"]</h1></div>
<div class="card form-narrow">
    <div class="card-body stack">
        <p>@T.Html("Delete <strong>{0}</strong>? A name that is placed in a village must be removed there first.", Model.Name)</p>
        <form asp-action="Delete" method="post" class="actions">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">@Icon.Render("trash") @T["Delete"]</button>
            <a asp-action="Index" class="btn btn-ghost">@T["Cancel"]</a>
        </form>
    </div>
</div>
