@using Microsoft.AspNetCore.Authorization
@using VotingApp.Application.Security
@inject IAuthorizationService Authz
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var isAdmin = signedIn && User.IsInRole(Permissions.AdminRole);
    async Task<bool> Can(string policy) => signedIn && (await Authz.AuthorizeAsync(User, policy)).Succeeded;
    var canResults = await Can(Permissions.EnterResults + "|" + Permissions.VerifyResults + "|" + Permissions.ApproveResults + "|" + Permissions.LockResults);
    var canElections = await Can(Permissions.ManageElections);
    var canCandidates = await Can(Permissions.ManageCandidates);
    var canStations = await Can(Permissions.ManagePollingStations);
    var canAudit = await Can(Permissions.ViewAuditLog);
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Current(params string[] names) => names.Contains(controller) ? "page" : null;
    var title = ViewData["Title"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>@(string.IsNullOrEmpty(title) ? "Election Results" : title + " · Election Results")</title>
    <script>
        // Apply the saved theme before first paint (no flash).
        try { var t = localStorage.getItem("theme"); if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t); } catch (e) { }
    </script>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
        <div class="container bar">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 12 2 2 4-4" /><path d="M5 7a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v12H5V7Z" /><path d="M22 19H2" /></svg>
                <span>Election Results <span class="visually-hidden">Timor-Leste</span></span>
            </a>

            <button type="button" class="btn btn-ghost nav-toggle" aria-controls="site-nav" aria-expanded="false" style="color:#fff">
                @Icon.Render("menu") <span>Menu</span>
            </button>

            <nav id="site-nav" class="nav" aria-label="Main">
                <a asp-area="" asp-controller="Home" asp-action="Index" aria-current="@Current("Home", "Results")">@Icon.Render("chart") Results</a>
                <a asp-area="" asp-controller="Elections" asp-action="Index" aria-current="@Current("Elections", "ResultSheets")">@Icon.Render("vote") Elections</a>

                @if (signedIn && (canResults || canElections || canCandidates || canStations || canAudit || isAdmin))
                {
                    <details>
                        <summary>@Icon.Render("database") Manage @Icon.Render("chevron-down")</summary>
                        <div class="menu">
                            @if (canResults || canElections)
                            {
                                <a asp-area="" asp-controller="Elections" asp-action="Index">@Icon.Render("file") Result sheets</a>
                            }
                            <span class="menu-label">Reference data</span>
                            <a asp-area="" asp-controller="Candidates" asp-action="Index">@Icon.Render("user") Candidates</a>
                            <a asp-area="" asp-controller="Parties" asp-action="Index">@Icon.Render("landmark") Parties and coalitions</a>
                            <a asp-area="" asp-controller="PollingStationAreas" asp-action="Index">@Icon.Render("pin") Polling stations</a>
                            <a asp-area="" asp-controller="Areas" asp-action="Index">@Icon.Render("map") Areas</a>
                            @if (isAdmin || canAudit)
                            {
                                <hr />
                                <span class="menu-label">Administration</span>
                                @if (isAdmin)
                                {
                                    <a asp-area="" asp-controller="Admin" asp-action="Users">@Icon.Render("users") Users and roles</a>
                                    <a asp-area="" asp-controller="Elections" asp-action="Scopes">@Icon.Render("shield") User municipalities</a>
                                }
                                @if (canAudit)
                                {
                                    <a asp-area="" asp-controller="AuditLog" asp-action="Index">@Icon.Render("history") Audit log</a>
                                }
                            }
                        </div>
                    </details>
                }

                <button type="button" class="linklike theme-toggle" aria-label="Colour theme: system" title="Colour theme" style="color:#dbe5f1;text-decoration:none;min-height:44px;padding:0 .75rem">
                    <span data-theme-icon="system">@Icon.Render("monitor")</span>
                    <span data-theme-icon="light" hidden>@Icon.Render("sun")</span>
                    <span data-theme-icon="dark" hidden>@Icon.Render("moon")</span>
                </button>

                @if (signedIn)
                {
                    <details>
                        <summary>@Icon.Render("user") <span>@(User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity!.Name)</span> @Icon.Render("chevron-down")</summary>
                        <div class="menu">
                            <a asp-area="Identity" asp-page="/Account/Manage/Index">@Icon.Render("user") My account</a>
                            <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                <button type="submit" class="linklike" style="text-decoration:none;display:flex;gap:.45rem;align-items:center">@Icon.Render("log-out") Sign out</button>
                            </form>
                        </div>
                    </details>
                }
                else
                {
                    <a asp-area="Identity" asp-page="/Account/Login">@Icon.Render("log-in") Staff sign in</a>
                }
            </nav>
        </div>
    </header>

    <main id="main" tabindex="-1">
        <div class="container page">
            <partial name="_Flash" />
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer">
        <div class="container spread">
            <span>Provisional results are unofficial until certified by the competent electoral authorities.</span>
            <span class="cluster">
                <a asp-area="" asp-controller="Elections" asp-action="Index">Open data</a>
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </span>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
