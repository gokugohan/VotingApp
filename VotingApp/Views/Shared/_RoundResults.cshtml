@model RoundResultsPage
@{
    var s = Model.Summary;
    var b = Model.Breakdown;
    var hasResults = s.SheetsCounted > 0;
    var names = s.Contestants.ToDictionary(c => c.ContestantId, c => c.Name);
    string Name(Guid? id) => id.HasValue && names.TryGetValue(id.Value, out var n) ? n : "-";
    var isFinal = s.RoundStatus == ElectionStatus.Certified;
    var typeLabel = s.Type == ElectionType.Presidential ? "Presidential election" : "Parliamentary election";
    ViewData["Comparison"] = Model.Comparison;
}

<div data-live="@Url.Action("Signature", "Results", new { id = s.RoundId })" data-live-signature="@Model.Signature" class="stack-lg">

    <div class="page-header spread" style="margin-bottom:0">
        <div>
            <div class="eyebrow">@typeLabel@(s.RoundNumber > 1 ? $" · Round {s.RoundNumber} (runoff)" : "")</div>
            <h1>@s.ElectionName</h1>
            <div class="cluster small">
                @if (isFinal)
                {
                    <span class="badge badge-ok">@Icon.Render("check-circle") Certified</span>
                }
                else
                {
                    <span class="badge badge-warn">@Icon.Render("info") Provisional</span>
                    <span class="live"><span class="pulse" aria-hidden="true"></span> Live</span>
                }
                <span class="muted">Updated @s.GeneratedAtUtc.ToString("HH:mm") UTC</span>
                <span class="muted" data-live-status aria-live="polite"></span>
            </div>
        </div>
        @if (Model.Rounds != null && Model.Rounds.Count > 1)
        {
            <form method="get" action="@Url.Action("Index", "Home")" class="no-print">
                <label class="label" for="round-select">Election</label>
                <div class="cluster">
                    <select id="round-select" name="roundId" style="width:auto;max-width:22rem" onchange="this.form.submit()">
                        @foreach (var r in Model.Rounds)
                        {
                            <option value="@r.RoundId" selected="@(r.RoundId == s.RoundId)">@r.Label</option>
                        }
                    </select>
                    <noscript><button class="btn btn-secondary btn-sm" type="submit">Show</button></noscript>
                </div>
            </form>
        }
    </div>

    @* ---------- Headline numbers ---------- *@
    <section class="grid grid-4" aria-label="Key figures">
        <div class="card stat">
            <div class="label">Stations reporting</div>
            <div class="value">@s.ReportingPercent.ToString("0.#")%</div>
            <div class="meter" role="img" aria-label="@s.ReportingPercent.ToString("0.#") percent of polling stations reporting" style="margin-top:.5rem"><span style="width:@s.ReportingPercent.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></span></div>
            <div class="sub">@s.SheetsCounted.ToString("N0") of @s.PollingStations.ToString("N0") stations</div>
        </div>
        <div class="card stat">
            <div class="label">Valid votes</div>
            <div class="value">@s.ValidVotes.ToString("N0")</div>
            <div class="sub">counted so far</div>
        </div>
        <div class="card stat">
            <div class="label">Blank votes</div>
            <div class="value">@s.BlankVotes.ToString("N0")</div>
        </div>
        <div class="card stat">
            <div class="label">Invalid votes</div>
            <div class="value">@s.InvalidVotes.ToString("N0")</div>
        </div>
    </section>

    @* ---------- Outcome ---------- *@
    @if (!hasResults)
    {
        <div class="alert alert-info">@Icon.Render("info") <div>No polling station sheets have been approved yet. Results appear here as soon as they are.</div></div>
    }
    else if (s.Presidential != null)
    {
        var p = s.Presidential;
        <div class="alert alert-info" role="status">
            @Icon.Render("info")
            <div>
                @switch (p.Outcome)
                {
                    case PresidentialOutcome.Elected:
                        <strong>@Name(p.WinnerId)</strong><span> has more than half of the valid votes counted so far.</span>
                        break;
                    case PresidentialOutcome.Runoff:
                        <span>No candidate has more than half of the valid votes counted so far (@p.MajorityThreshold.ToString("N0") needed). </span>
                        <span>A runoff would be between <strong>@Name(p.RunoffContestantIds[0])</strong> and <strong>@Name(p.RunoffContestantIds[1])</strong>.</span>
                        break;
                    case PresidentialOutcome.TieRequiresResolution:
                        <span>A tie between @string.Join(", ", p.TiedContestantIds.Select(id => Name(id))) decides the outcome and must be resolved under the law.</span>
                        break;
                }
                @if (!isFinal)
                {
                    <span class="muted"> Counting continues; this can change.</span>
                }
            </div>
        </div>
    }
    else if (s.Parliamentary != null)
    {
        var pr = s.Parliamentary;
        <div class="alert alert-info" role="status">
            @Icon.Render("info")
            <div>
                Projected allocation of <strong>@pr.TotalSeats seats</strong> (D'Hondt method, @pr.ThresholdPercent.ToString("0.##")% threshold) from the votes counted so far.
                @if (pr.LastSeatWinnerId.HasValue)
                {
                    <span>The last seat goes to <strong>@Name(pr.LastSeatWinnerId)</strong>@(pr.LastSeatDecidedByTie ? " (decided by a tie-break)" : ""); next in line: <strong>@Name(pr.NextInLineId)</strong>.</span>
                }
            </div>
        </div>
    }

    <div class="grid grid-main">
        @* ---------- Contestant results ---------- *@
        <section class="card" aria-labelledby="results-heading">
            <div class="card-header"><h2 id="results-heading">@(s.Type == ElectionType.Presidential ? "Candidates" : "Parties and coalitions")</h2></div>
            <div class="card-body stack-lg">
                <partial name="_ContestantBars" model="s" />
                @if (s.Parliamentary != null && hasResults)
                {
                    <partial name="_SeatChart" model="s" />
                }
            </div>
        </section>

        @* ---------- Map ---------- *@
        <section class="card" aria-labelledby="map-heading">
            <div class="card-header">
                <h2 id="map-heading">By municipality</h2>
                <form method="get" action="@Model.PagePath" class="no-print">
                    <input type="hidden" name="roundId" value="@s.RoundId" />
                    <label class="visually-hidden" for="map-mode">Map shows</label>
                    <select id="map-mode" name="map" style="width:auto;min-height:36px;padding:.25rem .5rem" onchange="this.form.submit()">
                        <option value="">Leading @(s.Type == ElectionType.Presidential ? "candidate" : "party")</option>
                        @foreach (var c in b.Ballot)
                        {
                            <option value="@c.Id" selected="@(c.Id == Model.MapContestantId)">Share: @c.Name</option>
                        }
                    </select>
                    <noscript><button class="btn btn-secondary btn-sm" type="submit">Show</button></noscript>
                </form>
            </div>
            <div class="card-body">
                <partial name="_ResultsMap" model="Model" />
            </div>
        </section>
    </div>

    @* ---------- Elected members (parliamentary) ---------- *@
    @if (Model.Elected != null && Model.Elected.Count > 0)
    {
        <section class="card" aria-labelledby="elected-heading">
            <div class="card-header">
                <h2 id="elected-heading">Elected members@(isFinal ? "" : " (projected)")</h2>
                <span class="muted small">Seats filled from the top of each party's list</span>
            </div>
            <div class="card-body grid grid-3">
                @foreach (var party in Model.Elected)
                {
                    <div>
                        <h3 style="font-size:1rem;margin-bottom:.35rem">@party.Name <span class="muted" style="font-weight:400">· @party.Seats @(party.Seats == 1 ? "seat" : "seats")</span></h3>
                        <ol class="small" style="margin:0;padding-left:1.4rem">
                            @foreach (var m in party.Members)
                            {
                                <li value="@m.Position">@m.FullName</li>
                            }
                        </ol>
                        @if (party.Unfilled > 0)
                        {
                            <div class="badge badge-bad" style="margin-top:.35rem">@Icon.Render("alert") @party.Unfilled seat@(party.Unfilled == 1 ? "" : "s") without a candidate on the list</div>
                        }
                        <a class="small" asp-controller="PartyLists" asp-action="Details" asp-route-id="@party.ContestantId">Full list</a>
                    </div>
                }
            </div>
        </section>
    }

    @* ---------- Table by municipality (also the accessible alternative to the map) ---------- *@
    <section class="card" aria-labelledby="municipality-table-heading">
        <div class="card-header">
            <h2 id="municipality-table-heading">Municipality results</h2>
            <div class="cluster no-print">
                <a class="btn btn-secondary btn-sm" asp-controller="Results" asp-action="Csv" asp-route-id="@s.RoundId">@Icon.Render("download") CSV by polling station</a>
                <a class="btn btn-ghost btn-sm" asp-controller="Results" asp-action="Municipalities" asp-route-id="@s.RoundId">JSON</a>
                <a class="btn btn-ghost btn-sm" asp-controller="Results" asp-action="Summary" asp-route-id="@s.RoundId">Summary JSON</a>
            </div>
        </div>
        <div class="table-wrap">
            <table class="table">
                <caption class="visually-hidden">Votes counted, stations reporting and leading contestant per municipality</caption>
                <thead>
                    <tr>
                        <th scope="col">Municipality</th>
                        <th scope="col">Stations reporting</th>
                        <th scope="col">Leading</th>
                        <th scope="col" class="num">Valid votes</th>
                        <th scope="col"><span class="visually-hidden">Details</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in b.Municipalities)
                    {
                        <tr>
                            <th scope="row"><a asp-controller="Results" asp-action="Municipality" asp-route-roundId="@s.RoundId" asp-route-id="@m.MunicipalityId">@m.Name</a></th>
                            <td>
                                <div class="cluster" style="flex-wrap:nowrap">
                                    <div class="meter" style="width:5rem" aria-hidden="true"><span style="width:@m.ReportingPercent.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></span></div>
                                    <span class="small nowrap">@m.ReportingPercent.ToString("0.#")% <span class="muted">(@m.SheetsCounted/@m.PollingStations)</span></span>
                                </div>
                            </td>
                            <td>@(m.LeaderId.HasValue ? Name(m.LeaderId) : (m.ValidVotes > 0 ? "Tie" : "-"))</td>
                            <td class="num">@m.ValidVotes.ToString("N0")</td>
                            <td class="actions-cell"><a asp-controller="Results" asp-action="Municipality" asp-route-roundId="@s.RoundId" asp-route-id="@m.MunicipalityId" aria-label="Polling stations in @m.Name">Stations @Icon.Render("chevron-right")</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
