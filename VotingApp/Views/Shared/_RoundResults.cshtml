@model RoundResultsPage
@{
    var s = Model.Summary;
    var b = Model.Breakdown;
    var hasResults = s.SheetsCounted > 0;
    var names = s.Contestants.ToDictionary(c => c.ContestantId, c => c.Name);
    string Name(Guid? id) => id.HasValue && names.TryGetValue(id.Value, out var n) ? n : "-";
    var isFinal = s.RoundStatus == ElectionStatus.Certified;
    var typeLabel = s.Type == ElectionType.Presidential ? T["Presidential election"] : T["Parliamentary election"];
    ViewData["Comparison"] = Model.Comparison;
}

<div data-live="@Url.Action("Signature", "Results", new { id = s.RoundId })" data-live-signature="@Model.Signature" class="stack-lg">

    <div class="page-header spread" style="margin-bottom:0">
        <div>
            <div class="eyebrow">@typeLabel@(s.RoundNumber > 1 ? " · " + T["Runoff"] : "")</div>
            <h1>@s.ElectionName</h1>
            <div class="cluster small">
                @if (isFinal)
                {
                    <span class="badge badge-ok">@Icon.Render("check-circle") @T["Certified"]</span>
                }
                else
                {
                    <span class="badge badge-warn">@Icon.Render("info") @T["Provisional"]</span>
                    <span class="live"><span class="pulse" aria-hidden="true"></span> @T["Live"]</span>
                }
                <span class="muted">@T["Updated {0} UTC", s.GeneratedAtUtc.ToString("HH:mm")]</span>
                <span class="muted" data-live-status data-live-updated="@T["Results updated {0}"]" aria-live="polite"></span>
            </div>
        </div>
        @if (Model.Rounds != null && Model.Rounds.Count > 1)
        {
            <form method="get" action="@Url.Action("Index", "Home")" class="no-print">
                <label class="label" for="round-select">@T["Election"]</label>
                <div class="cluster">
                    <select id="round-select" name="roundId" style="width:auto;max-width:22rem" onchange="this.form.submit()">
                        @foreach (var r in Model.Rounds)
                        {
                            <option value="@r.RoundId" selected="@(r.RoundId == s.RoundId)">@r.Label</option>
                        }
                    </select>
                    <noscript><button class="btn btn-secondary btn-sm" type="submit">@T["Show"]</button></noscript>
                </div>
            </form>
        }
    </div>

    @* ---------- Headline numbers ---------- *@
    <section class="grid grid-4" aria-label="@T["Key figures"]">
        <div class="card stat">
            <div class="label">@T["Stations reporting"]</div>
            <div class="value">@s.ReportingPercent.ToString("0.#")%</div>
            <div class="meter" role="img" aria-label="@T["{0}% of polling stations reporting", s.ReportingPercent.ToString("0.#")]" style="margin-top:.5rem"><span style="width:@s.ReportingPercent.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></span></div>
            <div class="sub">@T["{0} of {1} stations", s.SheetsCounted.ToString("N0"), s.PollingStations.ToString("N0")]</div>
        </div>
        <div class="card stat">
            <div class="label">@T["Valid votes"]</div>
            <div class="value">@s.ValidVotes.ToString("N0")</div>
            <div class="sub">@T["counted so far"]</div>
        </div>
        <div class="card stat">
            <div class="label">@T["Blank votes"]</div>
            <div class="value">@s.BlankVotes.ToString("N0")</div>
        </div>
        <div class="card stat">
            <div class="label">@T["Invalid votes"]</div>
            <div class="value">@s.InvalidVotes.ToString("N0")</div>
        </div>
    </section>

    @* ---------- Outcome ---------- *@
    @if (!hasResults)
    {
        <div class="alert alert-info">@Icon.Render("info") <div>@T["No polling station sheets have been approved yet. Results appear here as soon as they are."]</div></div>
    }
    else if (s.Presidential != null)
    {
        var p = s.Presidential;
        <div class="alert alert-info" role="status">
            @Icon.Render("info")
            <div>
                @switch (p.Outcome)
                {
                    case PresidentialOutcome.Elected:
                        <span>@T.Html("<strong>{0}</strong> has more than half of the valid votes counted so far.", Name(p.WinnerId))</span>
                        break;
                    case PresidentialOutcome.Runoff:
                        <span>@T["No candidate has more than half of the valid votes counted so far ({0} needed).", p.MajorityThreshold.ToString("N0")] </span>
                        <span>@T.Html("A runoff would be between <strong>{0}</strong> and <strong>{1}</strong>.", Name(p.RunoffContestantIds[0]), Name(p.RunoffContestantIds[1]))</span>
                        break;
                    case PresidentialOutcome.TieRequiresResolution:
                        <span>@T["A tie between {0} decides the outcome and must be resolved under the law.", string.Join(", ", p.TiedContestantIds.Select(id => Name(id)))]</span>
                        break;
                }
                @if (!isFinal)
                {
                    <span class="muted"> @T["Counting continues; this can change."]</span>
                }
            </div>
        </div>
    }
    else if (s.Parliamentary != null)
    {
        var pr = s.Parliamentary;
        <div class="alert alert-info" role="status">
            @Icon.Render("info")
            <div>
                @T.Html("Projected allocation of <strong>{0} seats</strong> (D'Hondt method, {1}% threshold) from the votes counted so far.", pr.TotalSeats, pr.ThresholdPercent.ToString("0.##"))
                @if (pr.LastSeatWinnerId.HasValue)
                {
                    <span>@T.Html("The last seat goes to <strong>{0}</strong>; next in line: <strong>{1}</strong>.", Name(pr.LastSeatWinnerId), Name(pr.NextInLineId))@(pr.LastSeatDecidedByTie ? " " + T["(The last seat was decided by a tie-break.)"] : "")</span>
                }
            </div>
        </div>
    }

    <div class="grid grid-main">
        @* ---------- Contestant results ---------- *@
        <section class="card" aria-labelledby="results-heading">
            <div class="card-header"><h2 id="results-heading">@(s.Type == ElectionType.Presidential ? T["Candidates"] : T["Parties and coalitions"])</h2></div>
            <div class="card-body stack-lg">
                <partial name="_ContestantBars" model="s" />
                @if (s.Parliamentary != null && hasResults)
                {
                    <partial name="_SeatChart" model="s" />
                }
            </div>
        </section>

        @* ---------- Map ---------- *@
        <section class="card" aria-labelledby="map-heading">
            <div class="card-header">
                <h2 id="map-heading">@T["By municipality"]</h2>
                <form method="get" action="@Model.PagePath" class="no-print">
                    <input type="hidden" name="roundId" value="@s.RoundId" />
                    <label class="visually-hidden" for="map-mode">@T["Map shows"]</label>
                    <select id="map-mode" name="map" style="width:auto;min-height:36px;padding:.25rem .5rem" onchange="this.form.submit()">
                        <option value="">@(s.Type == ElectionType.Presidential ? T["Leading candidate"] : T["Leading party"])</option>
                        @foreach (var c in b.Ballot)
                        {
                            <option value="@c.Id" selected="@(c.Id == Model.MapContestantId)">@T["Share: {0}", c.Name]</option>
                        }
                    </select>
                    <noscript><button class="btn btn-secondary btn-sm" type="submit">@T["Show"]</button></noscript>
                </form>
            </div>
            <div class="card-body">
                <partial name="_ResultsMap" model="Model" />
            </div>
        </section>
    </div>

    @* ---------- Elected members (parliamentary) ---------- *@
    @if (Model.Elected != null && Model.Elected.Count > 0)
    {
        <section class="card" aria-labelledby="elected-heading">
            <div class="card-header">
                <h2 id="elected-heading">@(isFinal ? T["Elected members"] : T["Elected members (projected)"])</h2>
                <span class="muted small">@T["Seats filled from the top of each party's list"]</span>
            </div>
            <div class="card-body grid grid-3">
                @foreach (var party in Model.Elected)
                {
                    <div>
                        <h3 style="font-size:1rem;margin-bottom:.35rem">@party.Name <span class="muted" style="font-weight:400">· @(party.Seats == 1 ? T["1 seat"] : T["{0} seats", party.Seats])</span></h3>
                        <ul class="small" style="margin:0;padding-left:0;list-style:none">
                            @foreach (var m in party.Members)
                            {
                                <li><span class="muted num" style="display:inline-block;min-width:1.8rem">@(m.IsSubstitute ? T["S{0}", m.Position] : m.Position + ".")</span><span>@m.FullName</span>
                                    @if (m.Replaces != null) { <span class="muted">· @T["replaces {0}", m.Replaces]</span> }
                                </li>
                            }
                        </ul>
                        @if (party.Unfilled > 0)
                        {
                            <div class="badge badge-bad" style="margin-top:.35rem">@Icon.Render("alert") @T["Seats without a candidate on the list: {0}", party.Unfilled]</div>
                        }
                        <a class="small" asp-controller="PartyLists" asp-action="Details" asp-route-id="@party.ContestantId">@T["Full list"]</a>
                    </div>
                }
            </div>
        </section>
    }

    @* ---------- Table by municipality (also the accessible alternative to the map) ---------- *@
    <section class="card" aria-labelledby="municipality-table-heading">
        <div class="card-header">
            <h2 id="municipality-table-heading">@T["Municipality results"]</h2>
            <div class="cluster no-print">
                <a class="btn btn-secondary btn-sm" asp-controller="Results" asp-action="Official" asp-route-id="@s.RoundId">@Icon.Render("file") @T["Results record"]</a>
                <a class="btn btn-secondary btn-sm" asp-controller="Results" asp-action="Csv" asp-route-id="@s.RoundId">@Icon.Render("download") @T["CSV by polling station"]</a>
                <a class="btn btn-ghost btn-sm" asp-controller="Results" asp-action="Municipalities" asp-route-id="@s.RoundId">JSON</a>
                <a class="btn btn-ghost btn-sm" asp-controller="Results" asp-action="Summary" asp-route-id="@s.RoundId">@T["Summary JSON"]</a>
            </div>
        </div>
        <div class="table-wrap">
            <table class="table">
                <caption class="visually-hidden">@T["Votes counted, stations reporting and leading contestant per municipality"]</caption>
                <thead>
                    <tr>
                        <th scope="col">@T["Municipality"]</th>
                        <th scope="col">@T["Stations reporting"]</th>
                        <th scope="col">@T["Leading"]</th>
                        <th scope="col" class="num">@T["Valid votes"]</th>
                        <th scope="col"><span class="visually-hidden">@T["Details"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in b.Municipalities)
                    {
                        <tr>
                            <th scope="row"><a asp-controller="Results" asp-action="Municipality" asp-route-roundId="@s.RoundId" asp-route-id="@m.MunicipalityId">@m.Name</a></th>
                            <td>
                                <div class="cluster" style="flex-wrap:nowrap">
                                    <div class="meter" style="width:5rem" aria-hidden="true"><span style="width:@m.ReportingPercent.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></span></div>
                                    <span class="small nowrap">@m.ReportingPercent.ToString("0.#")% <span class="muted">(@m.SheetsCounted/@m.PollingStations)</span></span>
                                </div>
                            </td>
                            <td>@(m.LeaderId.HasValue ? Name(m.LeaderId) : (m.ValidVotes > 0 ? T["Tie"] : "-"))</td>
                            <td class="num">@m.ValidVotes.ToString("N0")</td>
                            <td class="actions-cell"><a asp-controller="Results" asp-action="Municipality" asp-route-roundId="@s.RoundId" asp-route-id="@m.MunicipalityId" aria-label="@T["Polling stations in {0}", m.Name]">@T["Stations"] @Icon.Render("chevron-right")</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
