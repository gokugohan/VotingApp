@* One-shot messages set by controllers via TempData["Success"] / TempData["Error"]. *@
@if (TempData["Success"] is string ok)
{
    <div class="alert alert-ok" role="status" style="margin-bottom:1rem">@Icon.Render("check-circle") <div>@ok</div></div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-bad" role="alert" style="margin-bottom:1rem">@Icon.Render("alert") <div>@error</div></div>
}
