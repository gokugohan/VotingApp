@model RoundResultsPage
@{
    ViewData["Title"] = Model?.Summary.ElectionName ?? T["Results"];
}

@if (Model == null)
{
    <div class="card">
        <div class="empty">
            @Icon.Render("vote", "icon")
            <h1 style="font-size:1.4rem;margin-top:.5rem">@T["No results to show yet"]</h1>
            <p>@T["Results appear here once an election round is being counted."]</p>
            <a class="btn btn-secondary" asp-controller="Elections" asp-action="Index">@T["See all elections"]</a>
        </div>
    </div>
}
else
{
    <partial name="_RoundResults" model="Model" />
}
