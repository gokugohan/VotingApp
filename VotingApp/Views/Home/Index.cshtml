@model RoundResultsPage
@{
    ViewData["Title"] = Model?.Summary.ElectionName ?? "Results";
}

@if (Model == null)
{
    <div class="card">
        <div class="empty">
            @Icon.Render("vote", "icon")
            <h1 style="font-size:1.4rem;margin-top:.5rem">No results to show yet</h1>
            <p>Results appear here once an election round is being counted.</p>
            <a class="btn btn-secondary" asp-controller="Elections" asp-action="Index">See all elections</a>
        </div>
    </div>
}
else
{
    <partial name="_RoundResults" model="Model" />
}
