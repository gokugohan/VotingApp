@{
    ViewData["Title"] = "Privacy";
}
<div class="page-header">
    <h1>Privacy</h1>
</div>
<div class="card form-narrow" style="max-width:48rem">
    <div class="card-body">
        <h2>Public visitors</h2>
        <p>Viewing results does not require an account. No tracking or advertising cookies are used. A preference for light or dark theme may be stored in your browser.</p>
        <h2>Staff accounts</h2>
        <p>For staff who sign in, the application stores name, e-mail, the time and IP address of the last sign-in, and a record of every change they make (the audit log). This is needed to show who entered, verified and approved each result sheet.</p>
        <h2>Published data</h2>
        <p>Approved polling station figures and photos of signed result sheets are published as open data. They contain no personal information about voters.</p>
    </div>
</div>
