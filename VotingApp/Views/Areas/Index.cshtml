@model IndexAreaModel
@{
    ViewData["Title"] = T["Areas"];
    var posts = Model.AdministrativePosts.ToLookup(p => p.ParentId);
    var villages = Model.Villages.ToLookup(v => v.ParentId);
}
<div class="page-header">
    <h1>@T["Administrative areas"]</h1>
    <p>@T["{0} municipalities, {1} administrative posts and {2} villages (sucos).", Model.Municipalities.Count, Model.AdministrativePosts.Count, Model.Villages.Count]</p>
</div>

<div class="field" style="max-width:24rem">
    <label for="area-search">@T["Find an area"]</label>
    <input id="area-search" type="search" placeholder="@T["Type a name…"]" autocomplete="off" />
</div>

<div class="stack" id="area-tree">
    @foreach (var m in Model.Municipalities.OrderBy(m => m.Name))
    {
        <details class="card" data-area-name="@m.Name.ToLowerInvariant()">
            <summary class="card-body spread" style="cursor:pointer;list-style:none">
                <span><strong>@m.Name</strong> <span class="muted small">@m.Id</span></span>
                <span class="badge">@T["{0} posts", posts[m.Id].Count()]</span>
            </summary>
            <div class="card-body" style="border-top:1px solid var(--border)">
                <div class="grid grid-2">
                    @foreach (var p in posts[m.Id].OrderBy(p => p.Name))
                    {
                        <div data-area-name="@p.Name.ToLowerInvariant()">
                            <h3 style="font-size:1rem;margin-bottom:.25rem">@p.Name</h3>
                            <p class="small muted" style="margin:0">@string.Join(" · ", villages[p.Id].OrderBy(v => v.Name).Select(v => v.Name))</p>
                        </div>
                    }
                </div>
            </div>
        </details>
    }
</div>

@section Scripts {
    <script>
        (function () {
            var input = document.getElementById("area-search");
            var items = document.querySelectorAll("#area-tree > details");
            input.addEventListener("input", function () {
                var q = input.value.trim().toLowerCase();
                items.forEach(function (d) {
                    var match = !q || d.textContent.toLowerCase().indexOf(q) >= 0;
                    d.hidden = !match;
                    d.open = !!q && match;
                });
            });
        })();
    </script>
}
