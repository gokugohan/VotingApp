@model PartySeatsPage
@{
    var list = Model.List;
    var c = list.Contestant;
    ViewData["Title"] = T["Seats"] + " · " + c.Name;
    var holders = Model.Holders.ToDictionary(h => h.CandidateId);
    var everyone = list.Effective.Concat(list.Substitutes).ToList();
    var nextInLine = everyone.FirstOrDefault(p => !p.HasSteppedDown && !holders.ContainsKey(p.Id)
        && (p.IsSubstitute || p.Position > (Model.Seats ?? 0)));
    var canStepDown = everyone.Where(p => !p.HasSteppedDown).ToList();
    var steppedDown = everyone.Count(p => p.HasSteppedDown);
    var unfilled = (Model.Seats ?? 0) - Model.Holders.Count;
    string Label(PartyListCandidate p) => p.IsSubstitute ? "S" + p.Position : p.Position.ToString();
}

<nav class="breadcrumbs" aria-label="@T["Breadcrumb"]">
    <a asp-controller="Elections" asp-action="Index">@T["Elections"]</a><span aria-hidden="true">/</span>
    <a asp-controller="Elections" asp-action="Details" asp-route-id="@list.Election.Id">@list.Election.Name</a><span aria-hidden="true">/</span>
    <span>@T["{0} seats", c.Name]</span>
</nav>
<div class="page-header spread">
    <div>
        <div class="eyebrow">@T["Seats after the election"]</div>
        <h1>@c.Name @if (!string.IsNullOrEmpty(c.Acronym)) { <span class="muted">(@c.Acronym)</span> }</h1>
        <p>@T["When a member steps down, their seat passes to the next available person: first the effective candidates who were not elected, then the substitutes, in list order. Check each case against the electoral law and the parliament's decision before recording it."]</p>
    </div>
    <a class="btn btn-secondary" asp-action="Details" asp-route-id="@c.Id">@Icon.Render("list") @T["Public list"]</a>
</div>

<section class="grid grid-4" aria-label="@T["Seat summary"]" style="margin-bottom:1.5rem">
    <div class="card stat"><div class="label">@T["Seats won"]</div><div class="value">@(Model.Seats?.ToString() ?? "–")</div><div class="sub">@(list.Election.Status == ElectionStatus.Certified ? T["certified"] : T["provisional"])</div></div>
    <div class="card stat"><div class="label">@T["Seats filled"]</div><div class="value">@Model.Holders.Count</div></div>
    <div class="card stat"><div class="label">@T["Stepped down"]</div><div class="value">@steppedDown</div></div>
    <div class="card stat"><div class="label">@T["Next in line"]</div><div class="value" style="font-size:1.1rem">@(nextInLine?.FullName ?? T["Nobody left"])</div></div>
</section>

@if (unfilled > 0)
{
    <div class="alert alert-bad" style="margin-bottom:1rem">@Icon.Render("alert") <div>@T["{0} seat(s) cannot be filled: nobody is left on the list.", unfilled]</div></div>
}

<div class="grid grid-side">
    <section class="card" aria-labelledby="people-heading">
        <div class="card-header"><h2 id="people-heading">@T["Everyone on the list"]</h2></div>
        <div class="table-wrap">
            <table class="table table-compact">
                <thead><tr><th scope="col" class="num" style="width:3.5rem">#</th><th scope="col">@T["Name"]</th><th scope="col">@T["Status"]</th><th scope="col"><span class="visually-hidden">@T["Actions"]</span></th></tr></thead>
                <tbody>
                    @foreach (var p in everyone)
                    {
                        <tr>
                            <td class="num">@Label(p)</td>
                            <td>@p.FullName <span class="muted small">@(p.Gender == Gender.Female ? "F" : "M")</span></td>
                            <td>
                                @if (holders.TryGetValue(p.Id, out var h))
                                {
                                    <span class="badge badge-ok">@T["Holds a seat"]</span>
                                    @if (h.Replaces != null) { <span class="small muted">@T["replaces {0}", h.Replaces]</span> }
                                }
                                else if (p.HasSteppedDown)
                                {
                                    <span class="badge badge-warn">@T["Stepped down {0}", p.SteppedDownOn.Value.ToString("yyyy-MM-dd")]</span>
                                    <span class="small muted">@T[PartySeatsPage.ReasonText(p.StepDownReason)]@(p.StepDownNote == null ? "" : " · " + p.StepDownNote)</span>
                                }
                                else if (p == nextInLine)
                                {
                                    <span class="badge">@T["Next in line"]</span>
                                }
                            </td>
                            <td class="actions-cell">
                                @if (p.HasSteppedDown)
                                {
                                    <form asp-action="Reinstate" method="post" class="inline" data-confirm="@T["Reinstate {0}? Whoever replaced them gives the seat back.", p.FullName]">
                                        <input type="hidden" name="contestantId" value="@c.Id" />
                                        <input type="hidden" name="candidateId" value="@p.Id" />
                                        <button class="btn btn-ghost btn-sm">@T["Reinstate"]</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (everyone.Count == 0)
                    {
                        <tr><td colspan="4" class="empty">@T["No list was entered for this party."]</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="card" aria-labelledby="stepdown-heading">
        <div class="card-header"><h2 id="stepdown-heading">@T["Record stepping down"]</h2></div>
        <div class="card-body">
            @if (!Model.CanRecord)
            {
                <p class="muted">@T["This can be recorded once results are provisional or certified."]</p>
            }
            else
            {
                <form asp-action="StepDown" method="post" class="stack">
                    <div asp-validation-summary="All" class="errors"></div>
                    <input type="hidden" asp-for="Form.ContestantId" />
                    <div class="field">
                        <label asp-for="Form.CandidateId">@T["Person"]</label>
                        <select asp-for="Form.CandidateId" required>
                            <option value="">@T["Choose…"]</option>
                            @foreach (var p in canStepDown)
                            {
                                <option value="@p.Id" selected="@(p.Id == Model.Form.CandidateId)">@Label(p). @p.FullName@(holders.ContainsKey(p.Id) ? " " + T["(holds a seat)"] : "")</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label asp-for="Form.Date">@T["Date"]</label>
                        <input asp-for="Form.Date" type="date" required />
                    </div>
                    <div class="field">
                        <label asp-for="Form.Reason">@T["Reason"]</label>
                        <select asp-for="Form.Reason" required>
                            <option value="">@T["Choose…"]</option>
                            @foreach (var r in Enum.GetValues<StepDownReason>())
                            {
                                <option value="@r" selected="@(r == Model.Form.Reason)">@T[PartySeatsPage.ReasonText(r)]</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label asp-for="Form.Note">@T["Note"] <span class="muted">@T["(optional: decision, reference)"]</span></label>
                        <input asp-for="Form.Note" maxlength="500" />
                    </div>
                    <div class="actions"><button class="btn btn-primary">@T["Record"]</button></div>
                    <p class="hint">@T["A member who joined the government and later returns can be reinstated from the list."]</p>
                </form>
            }
        </div>
    </section>
</div>
