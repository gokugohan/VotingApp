@model PartyList
@{
    var c = Model.Contestant;
    ViewData["Title"] = T["{0} list", c.Name];
}
<nav class="breadcrumbs" aria-label="@T["Breadcrumb"]">
    <a asp-controller="Elections" asp-action="Index">@T["Elections"]</a><span aria-hidden="true">/</span>
    <span>@Model.Election.Name</span><span aria-hidden="true">/</span><span>@c.Name</span>
</nav>
<div class="page-header">
    <div class="eyebrow">@T["Candidate list"] · @Model.Election.Name</div>
    <h1>@c.Name @if (!string.IsNullOrEmpty(c.Acronym)) { <span class="muted">(@c.Acronym)</span> }</h1>
    @if (Model.Election.Status == ElectionStatus.Setup)
    {
        <span class="badge badge-warn">@T["Draft: not public until the election opens"]</span>
    }
</div>

<div class="grid grid-2">
    @foreach (var (title, people) in new[] { (T["Effective candidates"], Model.Effective), (T["Substitutes"], Model.Substitutes) })
    {
        <section class="card">
            <div class="card-header"><h2>@title</h2><span class="badge">@people.Count</span></div>
            <div class="table-wrap">
                <table class="table table-compact">
                    <thead><tr><th scope="col" class="num" style="width:3.5rem">#</th><th scope="col">@T["Name"]</th><th scope="col">@T["Gender"]</th></tr></thead>
                    <tbody>
                        @foreach (var p in people)
                        {
                            <tr><td class="num">@p.Position</td><td>@p.FullName @if (p.HasSteppedDown) { <span class="badge">@T["Stepped down"]</span> }</td><td>@(p.Gender == Gender.Female ? T["Woman"] : T["Man"])</td></tr>
                        }
                        @if (people.Count == 0)
                        {
                            <tr><td colspan="3" class="empty">@T["None"]</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>
