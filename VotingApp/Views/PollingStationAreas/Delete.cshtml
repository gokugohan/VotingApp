@model VotingApp.Domain.Entities.PollingStationArea
@{
    ViewData["Title"] = T["Delete {0}", Model.PollingStation?.Name];
}
<nav class="breadcrumbs" aria-label="@T["Breadcrumb"]"><a asp-action="Index">@T["Polling stations"]</a><span aria-hidden="true">/</span><span>@Model.PollingStation?.Name</span></nav>
<div class="page-header"><h1>@T["Delete polling station"]</h1></div>
<div class="card form-narrow">
    <div class="card-body stack">
        <p>@T.Html("Delete <strong>{0}</strong> in {1}? Stations with recorded results cannot be deleted.", Model.PollingStation?.Name, Model.Area?.Name)</p>
        <form asp-action="Delete" method="post" class="actions">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-danger">@Icon.Render("trash") @T["Delete"]</button>
            <a asp-action="Index" class="btn btn-ghost">@T["Cancel"]</a>
        </form>
    </div>
</div>
