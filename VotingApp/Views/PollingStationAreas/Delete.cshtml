@model VotingApp.Domain.Entities.PollingStationArea
@{
    ViewData["Title"] = "Delete " + Model.PollingStation?.Name;
}
<nav class="breadcrumbs" aria-label="Breadcrumb"><a asp-action="Index">Polling stations</a><span aria-hidden="true">/</span><span>@Model.PollingStation?.Name</span></nav>
<div class="page-header"><h1>Delete polling station</h1></div>
<div class="card form-narrow">
    <div class="card-body stack">
        <p>Delete <strong>@Model.PollingStation?.Name</strong> in @Model.Area?.Name? Stations with recorded results cannot be deleted.</p>
        <form asp-action="Delete" method="post" class="actions">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-danger">@Icon.Render("trash") Delete</button>
            <a asp-action="Index" class="btn btn-ghost">Cancel</a>
        </form>
    </div>
</div>
