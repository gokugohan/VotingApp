@model EditPollingStationArea
@{
    ViewData["Title"] = T["Edit {0}", Model.StationName];
}
<nav class="breadcrumbs" aria-label="@T["Breadcrumb"]"><a asp-action="Index">@T["Polling stations"]</a><span aria-hidden="true">/</span><span>@Model.StationName</span></nav>
<div class="page-header"><h1>@T["Edit polling station"]</h1></div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card form-narrow">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="errors"></div>
        <input type="hidden" asp-for="Id" />
        <div class="field">
            <label asp-for="StationName">@T["Name"]</label>
            <input asp-for="StationName" required maxlength="200" />
            <span asp-validation-for="StationName" class="field-error"></span>
        </div>
        <p class="hint">@T.Html("Currently in <strong>{0}</strong>. To move the station, choose a different village.", Model.Area?.Name)</p>
        <div class="alert alert-info" style="margin-bottom:1rem">@Icon.Render("info") <div>@T["Changes apply to elections that open from now on. Elections already open keep the name and village this station had when they opened."]</div></div>
        <partial name="_LocationPicker" model="(Model.AreaId, Model.Area?.Name)" />
        <div class="actions">
            <button type="submit" class="btn btn-primary">@T["Save changes"]</button>
            <a asp-action="Index" class="btn btn-ghost">@T["Cancel"]</a>
        </div>
    </div>
</form>
