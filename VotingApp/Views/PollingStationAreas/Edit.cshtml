@model EditPollingStationArea
@{
    ViewData["Title"] = "Edit " + Model.StationName;
}
<nav class="breadcrumbs" aria-label="Breadcrumb"><a asp-action="Index">Polling stations</a><span aria-hidden="true">/</span><span>@Model.StationName</span></nav>
<div class="page-header"><h1>Edit polling station</h1></div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card form-narrow">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="errors"></div>
        <input type="hidden" asp-for="Id" />
        <div class="field">
            <label asp-for="StationName">Name</label>
            <input asp-for="StationName" required maxlength="200" />
            <span asp-validation-for="StationName" class="field-error"></span>
        </div>
        <p class="hint">Currently in <strong>@Model.Area?.Name</strong>. To move the station, choose a different village.</p>
        <div class="alert alert-info" style="margin-bottom:1rem">@Icon.Render("info") <div>Changes apply to elections that open from now on. Elections already open keep the name and village this station had when they opened.</div></div>
        <partial name="_LocationPicker" model="(Model.AreaId, Model.Area?.Name)" />
        <div class="actions">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a asp-action="Index" class="btn btn-ghost">Cancel</a>
        </div>
    </div>
</form>
