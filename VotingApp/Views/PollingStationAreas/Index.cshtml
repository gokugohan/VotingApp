@model IEnumerable<VotingApp.Domain.Entities.Area>
@using VotingApp.Application.Security
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService Authz
@{
    ViewData["Title"] = "Polling stations";
    var locations = (List<VotingApp.Domain.Entities.PollingStationArea>)ViewData["PollingStations"];
    var selected = (string)ViewData["MunicipalityId"];
    var municipalityNames = Model.ToDictionary(m => m.Id, m => m.Name);
    string MunicipalityOf(string areaId) => areaId != null && areaId.Length >= 6 && municipalityNames.TryGetValue(areaId.Substring(0, 6), out var n) ? n : "";
    var canManage = User.Identity?.IsAuthenticated == true && (await Authz.AuthorizeAsync(User, Permissions.ManagePollingStations)).Succeeded;
}
<div class="page-header spread">
    <div>
        <h1>Polling stations</h1>
        <p>@locations.Count station@(locations.Count == 1 ? "" : "s")@(string.IsNullOrEmpty(selected) ? "" : " in " + municipalityNames.GetValueOrDefault(selected)). Results are recorded per station.</p>
    </div>
    @if (canManage)
    {
        <a asp-action="Create" class="btn btn-primary">@Icon.Render("plus") New polling station</a>
    }
</div>

<div class="card">
    <div class="card-header">
        <form method="get" class="cluster">
            <label for="muni" class="label">Municipality</label>
            <select id="muni" name="municipalityId" onchange="this.form.submit()" style="width:auto">
                <option value="">All municipalities</option>
                @foreach (var m in Model)
                {
                    <option value="@m.Id" selected="@(m.Id == selected)">@m.Name</option>
                }
            </select>
            <noscript><button class="btn btn-secondary btn-sm">Filter</button></noscript>
        </form>
    </div>
    <div class="table-wrap">
        <table class="table">
            <thead><tr><th scope="col">Polling station</th><th scope="col">Village</th><th scope="col">Municipality</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
            <tbody>
                @foreach (var l in locations)
                {
                    <tr>
                        <th scope="row"><a asp-action="Details" asp-route-id="@l.Id">@l.PollingStation?.Name</a></th>
                        <td>@l.Area?.Name</td>
                        <td>@MunicipalityOf(l.AreaId)</td>
                        <td class="actions-cell">
                            @if (canManage)
                            {
                                <a class="btn btn-ghost btn-sm" asp-action="Edit" asp-route-id="@l.Id" aria-label="Edit @l.PollingStation?.Name">@Icon.Render("pencil") Edit</a>
                                <a class="btn btn-ghost btn-sm" asp-action="Delete" asp-route-id="@l.Id" aria-label="Delete @l.PollingStation?.Name">@Icon.Render("trash") Delete</a>
                            }
                        </td>
                    </tr>
                }
                @if (locations.Count == 0)
                {
                    <tr><td colspan="4" class="empty">No polling stations here yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
